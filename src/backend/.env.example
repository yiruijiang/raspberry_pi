# Baby Monitor backend — environment variable reference
# Copy to .env and fill in real values before starting the server.
# NEVER commit a .env file with real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── TLS (leave blank for plain HTTP during development) ─────────────────────
# Point at your certificate and key files on the Pi for production HTTPS/WSS.
# TLS_CERTFILE=/etc/ssl/baby-monitor/cert.pem
# TLS_KEYFILE=/etc/ssl/baby-monitor/key.pem

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Dashboard login credentials
MONITOR_USERNAME=admin
MONITOR_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Camera ───────────────────────────────────────────────────────────────────
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
JPEG_QUALITY=75

# ── Audio ────────────────────────────────────────────────────────────────────
# Leave AUDIO_DEVICE_INDEX blank to use system default microphone.
# AUDIO_DEVICE_INDEX=1
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_FRAMES=1024

# ── ML socket (Phase 2) ──────────────────────────────────────────────────────
ML_SOCKET_PATH=/tmp/baby_monitor_ml.sock

# ── Alert system ─────────────────────────────────────────────────────────────
ALERT_BUFFER_SIZE=50
ALERT_MAX_AGE_SECONDS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use * only during development.
# Example for Pi on static LAN IP: CORS_ORIGINS=http://192.168.1.42:8000
CORS_ORIGINS=*
