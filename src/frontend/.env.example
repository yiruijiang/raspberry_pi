# Copy this file to .env.local and fill in values for your environment.
# .env.local is gitignored — never commit credentials.

# Override to point the frontend at a specific backend origin.
# Leave empty (default) to use the Vite dev proxy (vite.config.ts).
# In production, set this to e.g. http://raspberrypi.local:8000
VITE_API_BASE_URL=
